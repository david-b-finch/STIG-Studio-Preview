{
  "title": "DEMO ONLY — RHEL 8 V2R4 mixed assessments — PARTIAL STIG",
  "id": "7b5e16af-98e3-5974-af57-ad33635f4fda",
  "stigs": [
    {
      "stig_name": "Red Hat Enterprise Linux 8 Security Technical Implementation Guide",
