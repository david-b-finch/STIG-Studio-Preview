{
  "title": "DEMO ONLY — RHEL 8 V2R8 unreviewed reference sample — PARTIAL STIG",
  "id": "d48b5d32-42ee-5563-a1bf-3e667c8a28d5",
  "stigs": [
    {
      "stig_name": "Red Hat Enterprise Linux 8 Security Technical Implementation Guide",
      "display_name": "Red Hat Enterprise Linux 8",
      "stig_id": "RHEL_8_STIG",
