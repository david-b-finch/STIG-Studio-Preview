          "stig_uuid": "486d11cb-a951-575a-a398-33072a904038",
          "status": "not_reviewed",
          "comments": "",
          "finding_details": "",
          "overrides": {},
          "xccdf_source": {
            "benchmark_id": "RHEL_8_STIG",
            "rule_id": "SV-230228r1069299_rule",
            "check_system": "C-32897r1069207_chk",
            "references": [
              {
                "href": "",
