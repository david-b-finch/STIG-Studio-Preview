            {
              "id": "V-230230",
              "title": "SRG-OS-000067-GPOS-00035",
              "description": "<GroupDescription></GroupDescription>"
            }
          ],
          "group_title": "RHEL 8, for certificate-based authentication, must enforce authorized access to the corresponding private key.",
          "rule_id_src": "SV-230230r1069287_rule",
          "rule_id": "SV-230230r1069287",
          "rule_version": "RHEL-08-010100",
          "rule_title": "RHEL 8, for certificate-based authentication, must enforce authorized access to the corresponding private key.",
          "severity": "medium",
          "weight": "10.0",
          "discussion": "If an unauthorized user obtains access to a private key without a passcode, that user would have unauthorized access to any system where the associated public key has been installed.",
          "check_content": "Verify the SSH private key files have a passcode.\n\nFor each private key stored on the system, use the following command:\n\n$ sudo ssh-keygen -y -f /path/to/file\nEnter passphrase:\n\nIf the contents of the key are displayed, this is a finding.",
          "check_content_ref": {
            "href": "Red_Hat_Enterprise_Linux_8_STIG.xml",
            "name": "M"
          },
          "fix_text": "Create a new private and public key pair that utilizes a passcode with the following command:\n\n$ sudo ssh-keygen -p -f /path/to/file",
          "ccis": [
            "CCI-000186"
          ],
          "legacy_ids": [],
          "srg_id": "SRG-OS-000067-GPOS-00035",
          "false_positives": "",
          "false_negatives": "",
          "documentable": "false",
