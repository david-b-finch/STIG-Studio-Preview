          "uuid": "aaef4368-987a-5763-a087-54000b487895",
          "stig_uuid": "fdcc36ac-0380-5e93-a14c-28c0dcd68a2d",
          "status": "not_reviewed",
          "comments": "",
          "finding_details": "",
          "overrides": {},
          "xccdf_source": {
            "benchmark_id": "Apache_Server_2-4_UNIX_Site_STIG",
            "rule_id": "SV-214282r960963_rule",
            "check_system": "C-15495r881473_chk",
            "references": [
              {
                "href": "",
