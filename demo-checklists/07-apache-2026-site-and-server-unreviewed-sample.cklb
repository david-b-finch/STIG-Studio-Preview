          "reference_identifier": "3997",
          "uuid": "2650fb1d-3cc5-5008-a77d-d2e9f06b18de",
          "stig_uuid": "fdcc36ac-0380-5e93-a14c-28c0dcd68a2d",
          "status": "not_reviewed",
          "comments": "",
          "finding_details": "",
          "overrides": {},
          "xccdf_source": {
            "benchmark_id": "Apache_Server_2-4_UNIX_Site_STIG",
            "rule_id": "SV-214280r960963_rule",
            "check_system": "C-15493r277181_chk",
            "references": [
              {
                "href": "",
