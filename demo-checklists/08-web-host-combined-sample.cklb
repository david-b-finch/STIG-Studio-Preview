          "stig_uuid": "a7c7b20e-71cf-5d2d-a0ec-2d6e93e3e19b",
          "status": "not_applicable",
          "comments": "DEMO ONLY — fictional review by Demo Reviewer A. No check commands were executed.\nReference: V-230223 / SV-230223r1069327_rule. Unicode sample: café, résumé, Ω.",
          "finding_details": "DEMO ONLY — fictional scope decision.\nThe example feature is not used on this imaginary asset. This is not applicability guidance.",
          "overrides": {},
          "xccdf_source": {
            "benchmark_id": "RHEL_8_STIG",
